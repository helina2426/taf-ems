# Which environment the app runs in: development or production
NODE_ENV=development

# Port the backend listens on
PORT=4000

# Database connection address.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://taf_ems_user:CHANGE_ME@localhost:5432/taf_ems_dev?schema=public"

# Secret key used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# How long a login lasts (for example 8h = 8 hours)
JWT_EXPIRES_IN=8h