# Settings for the AUTOMATED TESTS only (npm run test:api).
# Copy this file to ".env.test" and fill in the password and a secret.
# The tests use their OWN database (taf_ems_test), which is wiped and refilled
# with demo data at the start of every test run. NEVER point this at real data.

NODE_ENV=test
# A different port, so the test server can run while your normal server (4000) is running.
PORT=4001

# Must end in _test: the test script refuses to wipe any other database.
DATABASE_URL="postgresql://taf_ems_user:CHANGE_ME@localhost:5432/taf_ems_test?schema=public"

# Any long random string (different from the one in .env). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=8h

CORS_ORIGINS=http://localhost:5173
# The collection sends ~360 requests per run, so the test server allows many more.
RATE_LIMIT_MAX=100000
LOGIN_MAX_FAILURES=5
