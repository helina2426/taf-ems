{
  "name": "taf-ems-backend",
  "version": "0.1.0",
  "description": "Backend API for the Taf Energies Employee Management and Performance Evaluation System",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node --env-file=.env prisma/seed.js",
    "db:studio": "prisma studio"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "express": "^5.3.0",
    "jose": "6.2.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prisma": "7.10.1"
  }
}
