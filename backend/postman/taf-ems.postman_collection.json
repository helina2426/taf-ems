              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "// Remember the ids of the two demo companies for the next requests.",
                  "const items = pm.response.json().data.items;",
                  "const alpha = items.find((c) => c.code === 'ALPHA');",
                  "const beta = items.find((c) => c.code === 'BETA');",
                  "pm.test('Both demo companies are listed', () => { pm.expect(alpha).to.exist; pm.expect(beta).to.exist; });",
                  "pm.environment.set('alphaCompanyId', alpha.id);",
                  "pm.environment.set('betaCompanyId', beta.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/companies?page=1&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "companies"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
