// ============================================================================
// Taf EMS — Database schema
// Built from docs/03-database-design.md (approved ERD, draft 1).
// Each "model" below becomes one table in PostgreSQL.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// ENUMS — fixed lists of allowed values
// ----------------------------------------------------------------------------

enum Role {
  HOLDING
  MANAGER
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PeriodStatus {
  UPCOMING
  OPEN
  CLOSED
}

enum SelfAssessmentStatus {
  DRAFT
  SUBMITTED
}

enum EvaluationType {
  EMPLOYEE
  MANAGER
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
  PUBLISHED
}

enum ReviewDecision {
  APPROVED
  RETURNED
}

// Version 2 (Module 17): a request to change a KPI target during the year.
enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Version 2 (Module 18): appeals against a low rating.
enum AppealStatus {
  SUBMITTED // waiting for a decision
  DECIDED // final
}

enum AppealOutcome {
  RATING_KEPT
  RATING_CHANGED
}

// Version 2 (Module 16): the UN-style rating of a plan-based evaluation.
enum EvaluationRating {
  EXCEEDS // 90 or more
  SUCCESSFULLY_MEETS // 75–89
  PARTIALLY_MEETS // 55–74
  DOES_NOT_MEET // below 55
}

// ---- Version 2: plan-based evaluation (Module 11) ----

enum CalendarType {
  ETHIOPIAN
  GREGORIAN
}

enum CycleStatus {
  PLANNING
  ACTIVE
  CLOSED
}

enum PeriodType {
  YEAR
  HALF
  QUARTER
  MONTH
}

// ---- Version 2: plans and KPIs (Module 12) ----

enum PlanLevel {
  HOLDING
  COMPANY
  INDIVIDUAL
}

enum PlanStatus {
  DRAFT
  SUBMITTED
  RETURNED
  ACTIVE
}

// The four Balanced Scorecard perspectives.
enum Perspective {
  FINANCIAL
  CUSTOMER
  INTERNAL_PROCESS
  LEARNING_GROWTH
}

// Which result is good.
enum KpiDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
  EXACT
  ZERO
}

// How the months add up to a quarter, a half and the year.
enum KpiAggregation {
  SUM
  AVERAGE
  LAST
}

// ----------------------------------------------------------------------------
// ORGANIZATION
// ----------------------------------------------------------------------------

model Holding {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  cycleCalendar CalendarType @default(ETHIOPIAN) // which calendar NEW plan years follow
  weeklyCheckInsEnabled Boolean @default(true) // Module 14: the Head can switch weekly check-ins off
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  companies Company[]
  cycles    PerformanceCycle[]
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  holdingId String   @db.Uuid
  name      String   @unique
  code      String   @unique
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  holding            Holding             @relation(fields: [holdingId], references: [id])
  employees          Employee[]
  managerAssignments ManagerAssignment[]
  evaluations        Evaluation[]
  plans              Plan[]
  checkIns           WeeklyCheckIn[]

  @@index([holdingId])
}

// ----------------------------------------------------------------------------
// PEOPLE AND LOGINS
// ----------------------------------------------------------------------------

model User {
  id                    String       @id @default(uuid()) @db.Uuid
  email                 String       @unique
  passwordHash          String
  role                  Role
  isPrimaryHoldingUser  Boolean      @default(false)
  canApproveEvaluations Boolean      @default(false)
  isActive              Boolean      @default(true)
  mustChangePassword    Boolean      @default(true)
  lastLoginAt           DateTime?
  displayCalendar       CalendarType @default(ETHIOPIAN) // how this person sees dates
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  employee             Employee?
  managerAssignments   ManagerAssignment[]  @relation("AssignedManager")
  assignmentsMade      ManagerAssignment[]  @relation("AssignedBy")
  goalsCreated         PerformanceGoal[]
  goalProgressUpdates  GoalProgressUpdate[]
  periodsCreated       EvaluationPeriod[]
  evaluationsWritten   Evaluation[]         @relation("Evaluator")
  evaluationsPublished Evaluation[]         @relation("PublishedBy")
  reviews              EvaluationReview[]
  auditLogs            AuditLog[]
  cyclesCreated        PerformanceCycle[]
  plansCreated         Plan[]               @relation("PlanCreatedBy")
  plansApproved        Plan[]               @relation("PlanApprovedBy")
  actualsEntered       KpiMonth[]           @relation("ActualEnteredBy")
  actualsConfirmed     KpiMonth[]           @relation("ActualConfirmedBy")
  progressReviews      ProgressReview[]
  checkInReplies       WeeklyCheckIn[]      @relation("CheckInRepliedBy")
  changesRequested     KpiChangeRequest[]   @relation("ChangeRequestedBy")
  changesDecided       KpiChangeRequest[]   @relation("ChangeDecidedBy")
  appealsDecided       EvaluationAppeal[]   @relation("AppealDecidedBy")
}

model Employee {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @unique @db.Uuid
  companyId        String           @db.Uuid
  employeeNumber   String
  firstName        String
  lastName         String
  jobTitle         String?
  department       String?
  phone            String?
  address          String?
  emergencyContact String?
  hireDate         DateTime?        @db.Date
  employmentStatus EmploymentStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user            User              @relation(fields: [userId], references: [id])
  company         Company           @relation(fields: [companyId], references: [id])
  goals           PerformanceGoal[]
  selfAssessments SelfAssessment[]
  evaluations     Evaluation[]
  plans           Plan[]
  checkIns        WeeklyCheckIn[]

  @@unique([companyId, employeeNumber])
  @@index([companyId])
}

model ManagerAssignment {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  managerUserId String    @db.Uuid
  assignedById  String    @db.Uuid
  startDate     DateTime  @default(now())
  endDate       DateTime? // empty (null) while the assignment is active
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company    Company @relation(fields: [companyId], references: [id])
  manager    User    @relation("AssignedManager", fields: [managerUserId], references: [id])
  assignedBy User    @relation("AssignedBy", fields: [assignedById], references: [id])

  @@index([companyId])
  @@index([managerUserId])
}

// ----------------------------------------------------------------------------
// GOALS
// ----------------------------------------------------------------------------

model PerformanceGoal {
  id              String     @id @default(uuid()) @db.Uuid
  employeeId      String     @db.Uuid
  periodId        String?    @db.Uuid
  createdById     String     @db.Uuid
  title           String
  description     String?
  objectives      String?
  kpi             String?
  targetResult    String?
  deadline        DateTime?  @db.Date
  progressPercent Int        @default(0)
  status          GoalStatus @default(NOT_STARTED)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  employee        Employee             @relation(fields: [employeeId], references: [id])
  period          EvaluationPeriod?    @relation(fields: [periodId], references: [id])
  createdBy       User                 @relation(fields: [createdById], references: [id])
  progressUpdates GoalProgressUpdate[]

  @@index([employeeId])
  @@index([periodId])
}

model GoalProgressUpdate {
  id              String   @id @default(uuid()) @db.Uuid
  goalId          String   @db.Uuid
  updatedById     String   @db.Uuid
  progressPercent Int
  comment         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  goal      PerformanceGoal @relation(fields: [goalId], references: [id])
  updatedBy User            @relation(fields: [updatedById], references: [id])

  @@index([goalId])
}

// ----------------------------------------------------------------------------
// EVALUATION SETUP
// ----------------------------------------------------------------------------

// One plan year (version 2). Its 19 periods are rows of EvaluationPeriod.
// The rules of the year are stored here, so changing them next year never changes this year.
model PerformanceCycle {
  id        String       @id @default(uuid()) @db.Uuid
  holdingId String       @db.Uuid
  name      String       @unique // "2019 EFY" or "2026 (GC)"
  calendar  CalendarType // copied from the Holding when the year is created
  year      Int // 2019 (Ethiopian) or 2026 (Gregorian)
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  status    CycleStatus  @default(PLANNING)

  // The rules of this year. The Head can change them only while the year is PLANNING.
  employeeResultsShare Int     @default(70) // points for KPIs; behaviours get the rest
  managerResultsShare  Int     @default(80)
  minKpis              Int     @default(3)
  maxKpis              Int     @default(7)
  minKpiWeight         Int     @default(10)
  maxKpiWeight         Int     @default(40)
  achievementCap       Int     @default(120) // percent
  minMonthsForRating   Int     @default(6)
  appealDays           Int     @default(14)
  planDeadlineDays     Int     @default(30)
  safetyCapEnabled     Boolean @default(false)

  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  holding   Holding            @relation(fields: [holdingId], references: [id])
  createdBy User               @relation(fields: [createdById], references: [id])
  periods   EvaluationPeriod[]
  plans     Plan[]

  @@index([holdingId])
  @@index([startDate])
}

model EvaluationPeriod {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  cycleId     String?      @db.Uuid // empty for version-1 periods
  type        PeriodType   @default(YEAR)
  parentId    String?      @db.Uuid // month → its quarter, quarter → its half, half → the year
  sequence    Int          @default(1) // months 1-12, quarters 1-4, halves 1-2
  startDate   DateTime     @db.Date
  endDate     DateTime     @db.Date
  status      PeriodStatus @default(UPCOMING)
  createdById String       @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdBy       User               @relation(fields: [createdById], references: [id])
  cycle           PerformanceCycle?  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  parent          EvaluationPeriod?  @relation("PeriodTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        EvaluationPeriod[] @relation("PeriodTree")
  goals           PerformanceGoal[]
  selfAssessments SelfAssessment[]
  evaluations     Evaluation[]
  kpiMonths       KpiMonth[]
  progressReviews ProgressReview[]

  @@unique([cycleId, type, sequence])
  @@index([parentId])
}

model EvaluationCriterion {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  description String?
  appliesTo   EvaluationType
  weight      Decimal        @db.Decimal(5, 2) // percent; active weights per list add up to 100
  isActive    Boolean        @default(true)
  // Version 2 (Module 15): criteria are now "behaviours".
  levelDescriptions Json? // what a score of 1, 2, 3, 4 and 5 looks like: a list of 5 short texts
  isSafety          Boolean @default(false) // the Safety behaviour (used by the optional safety rule)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  scores EvaluationScore[]

  @@index([appliesTo, isActive])
}

// ----------------------------------------------------------------------------
// SELF-ASSESSMENT AND EVALUATION
// ----------------------------------------------------------------------------

model SelfAssessment {
  id          String               @id @default(uuid()) @db.Uuid
  employeeId  String               @db.Uuid
  periodId    String               @db.Uuid
  comments    String?
  status      SelfAssessmentStatus @default(DRAFT)
  submittedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  employee Employee         @relation(fields: [employeeId], references: [id])
  period   EvaluationPeriod @relation(fields: [periodId], references: [id])

  @@unique([employeeId, periodId])
}

model Evaluation {
  id              String           @id @default(uuid()) @db.Uuid
  employeeId      String           @db.Uuid // the person being evaluated
  companyId       String           @db.Uuid // their company at the time of the evaluation
  periodId        String           @db.Uuid
  evaluatorId     String           @db.Uuid // the user who fills it in
  type            EvaluationType
  status          EvaluationStatus @default(DRAFT)
  overallScore    Decimal?         @db.Decimal(5, 2) // weighted percent
  feedback        String?
  recommendations String?
  submittedAt     DateTime?
  publishedAt     DateTime?
  publishedById   String?          @db.Uuid
  acknowledgedAt  DateTime?
  employeeComment String?
  // Version 2 (Module 16): plan-based evaluations (mid-year review on H1, annual on the YEAR period).
  resultsShare     Int? // points for the KPIs, copied from the plan year: 70 (employee) or 80 (Manager)
  resultsScore     Decimal?          @db.Decimal(5, 2) // points from the KPIs (calculated)
  behaviourScore   Decimal?          @db.Decimal(5, 2) // points from the behaviours (the evaluator)
  rating           EvaluationRating?
  safetyCapApplied Boolean           @default(false) // the safety rule lowered the rating
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  employee    Employee           @relation(fields: [employeeId], references: [id])
  company     Company            @relation(fields: [companyId], references: [id])
  period      EvaluationPeriod   @relation(fields: [periodId], references: [id])
  evaluator   User               @relation("Evaluator", fields: [evaluatorId], references: [id])
  publishedBy User?              @relation("PublishedBy", fields: [publishedById], references: [id])
  scores      EvaluationScore[]
  reviews     EvaluationReview[]
  appeal      EvaluationAppeal? // version 2 (Module 18): at most one appeal

  @@unique([employeeId, periodId])
  @@index([companyId, status])
  @@index([periodId])
  @@index([evaluatorId])
}

// One score of an evaluation. A row is EITHER a behaviour score (criterionId) OR,
// in version 2, a KPI score (kpiId) — never both (checked in the service).
model EvaluationScore {
  id           String   @id @default(uuid()) @db.Uuid
  evaluationId String   @db.Uuid
  criterionId  String?  @db.Uuid
  kpiId        String?  @db.Uuid // version 2: a KPI score, calculated from the confirmed monthly numbers
  score        Int // 1 to 5
  weightUsed   Decimal  @db.Decimal(5, 2) // version 1: percent; version 2: points out of 100
  comment      String?
  // Version 2, KPI rows only: the numbers the score was calculated from (kept for the history).
  targetUsed         Decimal? @db.Decimal(14, 2) // the target of the months that are known
  actualUsed         Decimal? @db.Decimal(14, 2) // the confirmed actual of those months
  achievementPercent Decimal? @db.Decimal(5, 1) // after the cap (120%)
  monthsUsed         Int? // how many months had a confirmed number
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  evaluation Evaluation           @relation(fields: [evaluationId], references: [id])
  criterion  EvaluationCriterion? @relation(fields: [criterionId], references: [id])
  kpi        Kpi?                 @relation(fields: [kpiId], references: [id])

  @@unique([evaluationId, criterionId])
  @@unique([evaluationId, kpiId])
}

model EvaluationReview {
  id           String         @id @default(uuid()) @db.Uuid
  evaluationId String         @db.Uuid
  reviewerId   String         @db.Uuid
  decision     ReviewDecision
  comment      String?
  decidedAt    DateTime       @default(now())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  evaluation Evaluation @relation(fields: [evaluationId], references: [id])
  reviewer   User       @relation(fields: [reviewerId], references: [id])

  @@index([evaluationId])
}

// ----------------------------------------------------------------------------
// PLANS AND KPIs (version 2, Module 12)
// ----------------------------------------------------------------------------

// One plan: the Holding's plan, a company's plan (= its Manager's plan), or one employee's plan.
model Plan {
  id                 String     @id @default(uuid()) @db.Uuid
  cycleId            String     @db.Uuid
  level              PlanLevel
  // "HOLDING", "COMPANY:<companyId>" or "EMPLOYEE:<employeeId>".
  // With (cycleId, scope) unique, each plan year has ONE Holding plan, one plan per company
  // and one plan per employee.
  scope              String
  companyId          String?    @db.Uuid // COMPANY and INDIVIDUAL plans
  employeeId         String?    @db.Uuid // INDIVIDUAL plans only
  status             PlanStatus @default(DRAFT)
  createdById        String     @db.Uuid
  submittedAt        DateTime?
  approvedById       String?    @db.Uuid // who approved (company plan) or activated it
  approvedAt         DateTime?
  returnComment      String?
  acknowledgedAt     DateTime? // INDIVIDUAL: the employee has read it
  acknowledgeComment String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  cycle      PerformanceCycle @relation(fields: [cycleId], references: [id])
  company    Company?         @relation(fields: [companyId], references: [id])
  employee   Employee?        @relation(fields: [employeeId], references: [id])
  createdBy  User             @relation("PlanCreatedBy", fields: [createdById], references: [id])
  approvedBy User?            @relation("PlanApprovedBy", fields: [approvedById], references: [id])
  kpis       Kpi[]
  reviews    ProgressReview[]

  @@unique([cycleId, scope])
  @@index([companyId])
  @@index([employeeId])
}

// One measured target inside a plan.
model Kpi {
  id          String         @id @default(uuid()) @db.Uuid
  planId      String         @db.Uuid
  parentKpiId String?        @db.Uuid // the KPI one level up that this one helps to reach
  perspective Perspective
  name        String
  description String?
  unit        String // "deliveries", "%", "litres", "ETB"
  direction   KpiDirection
  aggregation KpiAggregation @default(SUM)
  baseline    Decimal?       @db.Decimal(14, 2) // last year's value, for comparison
  yearTarget  Decimal        @db.Decimal(14, 2)
  weight      Int? // points out of 100; empty on the Holding plan
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  plan      Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  parentKpi Kpi?       @relation("KpiCascade", fields: [parentKpiId], references: [id])
  childKpis Kpi[]      @relation("KpiCascade")
  months    KpiMonth[]
  evaluationScores EvaluationScore[] // version 2: KPI scores in evaluations
  changeRequests   KpiChangeRequest[] // version 2: target changes during the year

  @@index([planId])
  @@index([parentKpiId])
}

// For one KPI and one month: the target and, from Module 13, the actual number.
model KpiMonth {
  id            String    @id @default(uuid()) @db.Uuid
  kpiId         String    @db.Uuid
  periodId      String    @db.Uuid // a MONTH period of the plan year
  target        Decimal   @db.Decimal(14, 2)
  actual        Decimal?  @db.Decimal(14, 2) // empty until someone enters it
  comment       String? // why the number is what it is (optional)
  enteredById   String?   @db.Uuid
  enteredAt     DateTime?
  confirmedById String?   @db.Uuid
  confirmedAt   DateTime? // only CONFIRMED actual numbers count in progress and scores
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  kpi         Kpi              @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  period      EvaluationPeriod @relation(fields: [periodId], references: [id])
  enteredBy   User?            @relation("ActualEnteredBy", fields: [enteredById], references: [id])
  confirmedBy User?            @relation("ActualConfirmedBy", fields: [confirmedById], references: [id])

  @@unique([kpiId, periodId])
  @@index([periodId])
}

// The comments of one plan for one month or quarter (Module 13). No score.
// owner    = the person whose plan it is (the employee, or the Manager for a company plan)
// reviewer = the person who checks it (the Manager, or the Holding for a company plan)
model ProgressReview {
  id                String    @id @default(uuid()) @db.Uuid
  planId            String    @db.Uuid
  periodId          String    @db.Uuid // a MONTH or QUARTER of the plan year
  ownerComment      String?
  ownerCommentAt    DateTime?
  reviewerComment   String?
  reviewerId        String?   @db.Uuid
  reviewerCommentAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  plan     Plan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  period   EvaluationPeriod @relation(fields: [periodId], references: [id])
  reviewer User?            @relation(fields: [reviewerId], references: [id])

  @@unique([planId, periodId])
  @@index([periodId])
}

// ----------------------------------------------------------------------------
// AUDIT
// ----------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid // empty for failed logins
  action     String
  entityType String?
  entityId   String?  @db.Uuid
  details    Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// WEEKLY CHECK-INS (version 2, Module 14)
// ----------------------------------------------------------------------------

// A short weekly note: what the employee did, what comes next, and what is blocking them.
// The Manager can reply. There is no score: it is a memory aid for the evaluations.
// companyId = the employee's company when the note was written, so if the employee moves
// to another company later, the old notes stay with the old company (the company wall).
model WeeklyCheckIn {
  id          String    @id @default(uuid()) @db.Uuid
  employeeId  String    @db.Uuid
  companyId   String    @db.Uuid
  weekStart   DateTime  @db.Date // the Monday of the week
  done        String // what I did this week
  next        String // what I will do next week
  blockers    String? // what is stopping me (optional)
  reply       String? // the Manager's reply
  repliedById String?   @db.Uuid
  repliedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee  Employee @relation(fields: [employeeId], references: [id])
  company   Company  @relation(fields: [companyId], references: [id])
  repliedBy User?    @relation("CheckInRepliedBy", fields: [repliedById], references: [id])

  @@unique([employeeId, weekStart])
  @@index([companyId, weekStart])
}

// ----------------------------------------------------------------------------
// TARGET CHANGES (version 2, Module 17)
// ----------------------------------------------------------------------------

// A request to change the year target of a KPI of an ACTIVE plan, with the reason.
//   Employee KPI: the Manager asks, the Head (or a Holding approver) decides.
//   Company / Holding KPI: the Head changes it directly (the request is saved as APPROVED, for the history).
// Months that are over or closed keep their old target; only the current and future months change.
// oldValues / newValues keep the year target and the 12 monthly targets before and after.
model KpiChangeRequest {
  id              String              @id @default(uuid()) @db.Uuid
  kpiId           String              @db.Uuid
  requestedById   String              @db.Uuid
  reason          String
  oldValues       Json // { yearTarget, months: [12 targets] }
  newValues       Json // { yearTarget, months: [12 targets] }
  status          ChangeRequestStatus @default(PENDING)
  decidedById     String?             @db.Uuid
  decidedAt       DateTime?
  decisionComment String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  kpi         Kpi   @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("ChangeRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User? @relation("ChangeDecidedBy", fields: [decidedById], references: [id])

  @@index([kpiId, status])
  @@index([status])
}

// ----------------------------------------------------------------------------
// APPEALS (version 2, Module 18)
// ----------------------------------------------------------------------------

// An appeal of the person evaluated against a "Partially meets" or "Does not meet" rating,
// within appealDays (14) after they acknowledged the evaluation. One per evaluation.
// Decided by ONE Holding approver who did not write or approve that evaluation. Final.
// originalRating / originalScore keep the rating before the appeal, so the history is never lost.
model EvaluationAppeal {
  id              String            @id @default(uuid()) @db.Uuid
  evaluationId    String            @unique @db.Uuid
  reason          String
  status          AppealStatus      @default(SUBMITTED)
  originalRating  EvaluationRating
  originalScore   Decimal           @db.Decimal(5, 2)
  outcome         AppealOutcome?
  newRating       EvaluationRating?
  newScore        Decimal?          @db.Decimal(5, 2)
  decisionComment String?
  decidedById     String?           @db.Uuid
  decidedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  evaluation Evaluation @relation(fields: [evaluationId], references: [id])
  decidedBy  User?      @relation("AppealDecidedBy", fields: [decidedById], references: [id])

  @@index([status])
}
